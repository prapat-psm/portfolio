PAYLOAD_SECRET=
DATABASE_URL=
RESEND_API_KEY=
# Sender on a domain verified in Resend. Leave empty to use Resend's test sender
# (then only the owner notification is sent, no auto-reply to the visitor).
CONTACT_FROM_EMAIL=
# Where new contact submissions are delivered.
CONTACT_TO_EMAIL=

NEXT_PUBLIC_SUPABASE_PROD_ID=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUB_KEY=
SUPABASE_SECRET_KEY=

S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=

# Optional Cloudflare Turnstile on the contact form (both must be set to enable it).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL for metadata/sitemap. Falls back to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
